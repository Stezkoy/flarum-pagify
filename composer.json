{
    "name": "stezkoy/flarum-pagify",
    "description": "Page-number pagination for the discussion list and post stream in Flarum.",
    "keywords": ["flarum", "extension", "pagination", "discussion", "posts"],
    "support": {
        "source": "https://github.com/Stezkoy/flarum-pagify",
        "issues": "https://github.com/Stezkoy/flarum-pagify/issues",
        "forum": "https://discuss.flarum.org/d/39822-pagify-pagination-for-the-forum"
    },
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Stezkoy",
            "email": "stezko@gmail.com"
        }
    ],
    "require": {
        "flarum/core": "^2.0",
        "php": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "Stezkoy\\Pagify\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Pagify",
            "category": "feature",
            "icon": {
                "name": "fas fa-list-ol",
                "backgroundColor": "#00a185",
                "color": "#fff"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
